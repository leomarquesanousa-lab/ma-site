# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Private original customer artwork (never serve directly from public/)
/.ma-storage/

# Local-only commerce target (contains no password)
/.ma-commerce.local.json
/.ma-local-init-result.json
/.ma-local-admin-result.json

# Private keys, database backups and storage inventories
*.key
*.p12
*.pfx
*.dump
*.backup
/backups/
/.ma-r2-inventory/

# Ephemeral, confirmation-gated remote migration staging
/.ma-neon-activation/
/.ma-neon-restore/
/.env.homologacao
!prisma/certs/neon-root-ca.pem
/.npm-cache/
